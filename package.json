{
  "name": "anchor",
  "version": "0.0.0",
  "private": true,
  "description": "Anchor — archery club management software",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10"
    }
