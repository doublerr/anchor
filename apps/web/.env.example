# Supabase — copy this file to `.env.local` and fill in the values from your
# project dashboard: Project Settings → API.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Both are safe to expose to the browser: the anon key only grants access
# allowed by your Row Level Security policies.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public marketing origin, used for canonical URLs, sitemap, robots, and
# social-share metadata. Defaults to https://anchorplatforms.site; override
# for preview/staging deploys. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://anchorplatforms.site

# Google Maps — powers address autocomplete + map preview in onboarding.
# Enable "Maps JavaScript API" and "Places API (New)" in Google Cloud, then
# create a browser key restricted to your domains. Billable per autocomplete
# session. If unset, address inputs fall back to plain manual fields.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
#
# Map ID for the map preview's AdvancedMarkerElement. Defaults to Google's
# reserved DEMO_MAP_ID (fine for dev); set a cloud-styled Map ID in production.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id
