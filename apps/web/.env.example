# Supabase — copy this file to `.env.local` and fill in the values from your
# project dashboard: Project Settings → API.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Both are safe to expose to the browser: the anon key only grants access
# allowed by your Row Level Security policies.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
